# syntax=docker/dockerfile:1
ARG NODE_IMAGE=node:24.19.0-bookworm-slim
ARG CODEGRAPH_VERSION=1.6.0

# Build Executor from this checkout so every fork release contains the tagged
# application source instead of inheriting an older published application.
FROM oven/bun:1.4.4@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d AS prod-deps
WORKDIR /app
COPY . .
RUN bun install --frozen-lockfile --production --ignore-scripts --filter @executor-js/host-selfhost \
  && bun run apps/host-selfhost/scripts/package-runtime.ts

FROM oven/bun:1.4.4@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d AS build
WORKDIR /app
COPY . .
ARG EXECUTOR_ALLOW_STDIO_MCP=true
ENV EXECUTOR_ALLOW_STDIO_MCP=${EXECUTOR_ALLOW_STDIO_MCP}
RUN bun install --frozen-lockfile
RUN cd apps/host-selfhost && bun run build

FROM debian:bookworm-slim AS tools
ARG TARGETARCH
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl tar \
  && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
  case "$TARGETARCH" in amd64|arm64) ;; *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1;; esac; \
  mkdir -p /tmp/signoz /out; \
  curl -fsSL -o /tmp/signoz.tar.gz "https://github.com/SigNoz/signoz-mcp-server/releases/latest/download/signoz-mcp-server_linux_${TARGETARCH}.tar.gz"; \
  tar -xzf /tmp/signoz.tar.gz -C /tmp/signoz; \
  install -Dm755 "/tmp/signoz/signoz-mcp-server_linux_${TARGETARCH}/bin/signoz-mcp-server" /out/signoz-mcp-server
RUN set -eux; \
  curl -fsSL -o /tmp/coder-install.sh https://coder.com/install.sh; \
  sh /tmp/coder-install.sh --stable --method standalone; \
  install -Dm755 "$(command -v coder)" /out/coder

# The published Executor image is intentionally distroless. This image runs
# user-configured stdio commands, so use a regular Debian runtime and copy the
# already-built Executor payload into it. This provides a normal POSIX process
# environment (sh, bash, env, coreutils), Node/npm/npx, and Bun/bunx without
# recompiling Executor in Coolify.
FROM ${NODE_IMAGE} AS runtime
ARG CODEGRAPH_VERSION
RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates coreutils git \
  && rm -rf /var/lib/apt/lists/*
RUN npm install --global "@colbymchenry/codegraph@${CODEGRAPH_VERSION}" \
  && npm cache clean --force

WORKDIR /app
COPY --from=prod-deps /usr/local/bin/bun /usr/local/bin/bun
RUN ln -s /usr/local/bin/bun /usr/local/bin/bunx
COPY --from=prod-deps /app/.selfhost-runtime /app
COPY --from=build /app/apps/host-selfhost/dist /app/apps/host-selfhost/dist
COPY --from=tools /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=tools /out/signoz-mcp-server /usr/local/bin/signoz-mcp-server
COPY --from=tools /out/coder /usr/local/bin/coder

# Set EXECUTOR_CODEGRAPH_GITHUB_REPOS to comma-separated owner/name values,
# provide a read-only EXECUTOR_CODEGRAPH_GITHUB_TOKEN, and schedule
# /usr/local/bin/codegraph-repo-sync with Coolify cron.
ENV NODE_ENV=production \
    EXECUTOR_HOST=0.0.0.0 \
    PORT=4788 \
    EXECUTOR_DATA_DIR=/data \
    EXECUTOR_CODEGRAPH_WORKSPACE=/workspace \
    EXECUTOR_CODEGRAPH_GITHUB_BRANCH=prod
COPY --chmod=755 scripts/codegraph-repo-sync.sh /usr/local/bin/codegraph-repo-sync
WORKDIR /app/apps/host-selfhost
# Persist repository checkouts and their in-tree .codegraph indexes separately
# from Executor's database and generated keys.
VOLUME ["/data", "/workspace"]
EXPOSE 4788
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=5 \
  CMD ["bun", "-e", "fetch('http://127.0.0.1:4788/api/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
CMD ["sh", "-c", "unset EXECUTOR_CODEGRAPH_GITHUB_TOKEN; exec bun run dist-server/serve.js"]
