# syntax=docker/dockerfile:1
# Derive from the published self-host image; Executor itself is not compiled here.
ARG EXECUTOR_IMAGE=ghcr.io/vizmo-vms/executor:1.5.42-vi.1
ARG NODE_IMAGE=node:24.19.0-bookworm-slim

FROM ${EXECUTOR_IMAGE} AS executor

FROM debian:bookworm-slim AS tools
ARG TARGETARCH
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl tar \
  && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
  case "$TARGETARCH" in amd64|arm64) ;; *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1;; esac; \
  mkdir -p /tmp/signoz /out; \
  curl -fsSL -o /tmp/signoz.tar.gz "https://github.com/SigNoz/signoz-mcp-server/releases/latest/download/signoz-mcp-server_linux_${TARGETARCH}.tar.gz"; \
  tar -xzf /tmp/signoz.tar.gz -C /tmp/signoz; \
  install -Dm755 "/tmp/signoz/signoz-mcp-server_linux_${TARGETARCH}/bin/signoz-mcp-server" /out/signoz-mcp-server
RUN set -eux; \
  curl -fsSL -o /tmp/coder-install.sh https://coder.com/install.sh; \
  sh /tmp/coder-install.sh --stable --method standalone; \
  install -Dm755 "$(command -v coder)" /out/coder

# The published Executor image is intentionally distroless. This image runs
# user-configured stdio commands, so use a regular Debian runtime and copy the
# already-built Executor payload into it. This provides a normal POSIX process
# environment (sh, bash, env, coreutils), Node/npm/npx, and Bun/bunx without
# recompiling Executor in Coolify.
FROM ${NODE_IMAGE} AS runtime
RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates coreutils \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=executor /usr/local/bin/bun /usr/local/bin/bun
RUN ln -s /usr/local/bin/bun /usr/local/bin/bunx
COPY --from=executor /app /app
COPY --from=tools /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=tools /out/signoz-mcp-server /usr/local/bin/signoz-mcp-server
COPY --from=tools /out/coder /usr/local/bin/coder

ENV NODE_ENV=production \
    EXECUTOR_HOST=0.0.0.0 \
    PORT=4788 \
    EXECUTOR_DATA_DIR=/data
WORKDIR /app/apps/host-selfhost
VOLUME ["/data"]
EXPOSE 4788
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=5 \
  CMD ["bun", "-e", "fetch('http://127.0.0.1:4788/api/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
CMD ["bun", "run", "dist-server/serve.js"]
