# syntax=docker/dockerfile:1
# Derive from the published self-host image; Executor itself is not compiled here.
ARG EXECUTOR_IMAGE=ghcr.io/vizmo-vms/executor:1.5.42-vi.1
ARG NODE_IMAGE=node:24.19.0-bookworm-slim

# Keep Node/npm's runtime files in a Debian 12 stage so they remain compatible
# with Executor's distroless Debian 12 base. The wrappers avoid /usr/bin/env,
# which is intentionally absent from the final distroless image.
FROM ${NODE_IMAGE} AS node
RUN set -eux; \
  mkdir -p /out; \
  printf '%s\n' '#!/usr/local/bin/node' \
    'require("/usr/local/lib/node_modules/npm/bin/npm-cli.js")' > /out/npm; \
  printf '%s\n' '#!/usr/local/bin/node' \
    'require("/usr/local/lib/node_modules/npm/bin/npx-cli.js")' > /out/npx; \
  chmod 0755 /out/npm /out/npx; \
  node --version; \
  npm --version; \
  npx --version

FROM debian:bookworm-slim AS tools
ARG TARGETARCH
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl tar \
  && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
  case "$TARGETARCH" in amd64|arm64) ;; *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1;; esac; \
  mkdir -p /tmp/signoz /out; \
  curl -fsSL -o /tmp/signoz.tar.gz "https://github.com/SigNoz/signoz-mcp-server/releases/latest/download/signoz-mcp-server_linux_${TARGETARCH}.tar.gz"; \
  tar -xzf /tmp/signoz.tar.gz -C /tmp/signoz; \
  install -Dm755 "/tmp/signoz/signoz-mcp-server_linux_${TARGETARCH}/bin/signoz-mcp-server" /out/signoz-mcp-server
RUN set -eux; \
  curl -fsSL -o /tmp/coder-install.sh https://coder.com/install.sh; \
  sh /tmp/coder-install.sh --stable --method standalone; \
  install -Dm755 "$(command -v coder)" /out/coder

FROM ${EXECUTOR_IMAGE}
COPY --from=tools /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
COPY --from=node /out/npm /usr/local/bin/npm
COPY --from=node /out/npx /usr/local/bin/npx
# npm and npx launch package commands through `sh`. The Executor base is
# distroless, so copy Debian 12's shell from the Node stage into the runtime.
COPY --from=node /bin/dash /bin/sh
# Third-party npm CLIs conventionally use `#!/usr/bin/env node`, including
# Sentry's `sentry-mcp` executable.
COPY --from=node /usr/bin/env /usr/bin/env
COPY --from=tools /out/signoz-mcp-server /usr/local/bin/signoz-mcp-server
COPY --from=tools /out/coder /usr/local/bin/coder
